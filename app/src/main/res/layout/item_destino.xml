<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="5dp"
    app:strokeColor="#C8E6C9"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- Imagen circular grande como antes -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_destino"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:src="@mipmap/ic_launcher"
            app:civ_border_color="#0B3C26"
            app:civ_border_width="3dp" />

        <!-- Nombre del destino grande y centrado -->
        <TextView
            android:id="@+id/tv_nombre_destino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Nombre Destino"
            android:textColor="#0B3C26"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Ubicación -->
        <TextView
            android:id="@+id/tv_ubicacion_destino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Ubicación, País"
            android:textColor="#2E7D32"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Franja inferior: duración a la izquierda y precio a la derecha sin centrar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E8F5E9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_duracion_destino"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="Plan 5 Días / 4 Noches"
                android:textColor="#455A64"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_precio_destino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="$ 2.800.000"
                android:textColor="#0B3C26"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>