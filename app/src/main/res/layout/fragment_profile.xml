<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7F4"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Encabezado superior -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Configuración"
        android:textColor="#0B3C26"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Cuenta &amp; Preferencias"
        android:textColor="#52796F"
        android:textSize="14sp" />

    <!-- Espacio flexible hacia el centro -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Texto único que muestra Usuario logueado: melannie -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usuario logueado:"
        android:textColor="#556B2F"
        android:textSize="16sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/tv_usuario_logueado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="melannie"
        android:textColor="#0B3C26"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Botón compacto de Cerrar Sesión con ancho ajustado (no ocupa todo el ancho) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cerrar_sesion"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:backgroundTint="#009688"
        app:cornerRadius="25dp"
        app:elevation="4dp"
        app:icon="@android:drawable/ic_lock_power_off"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="#FFFFFF" />

    <!-- Espacio flexible hacia abajo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

</LinearLayout>